<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.xusione.AVWOWE</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>Proprietary</project_license>
  <name>AVWOWE</name>
  <summary>Interactive Media Player &amp; Kiosk System</summary>

  <description>
    <p>
      AVWOWE turns media collections into nonstop on-screen magic.
    </p>
    <p>Features include:</p>
    <ul>
      <li>
        <strong>Always On:</strong> Point to local folders and cycle through media continuously. Optionally slice videos into automatic jump cuts for a custom montage look. Ideal for home screens, storefront displays, events, or ambient installations.
      </li>
      <li>
        <strong>Advanced Tickers:</strong> Add scrolling text bars anywhere on screen. Pull content from static text, local files, or live URLs refreshed automatically. Customize fonts, colors, sizes, and background images.
      </li>
      <li>
        <strong>Dynamic Overlays:</strong> Pin animated or static corner watermarks with full size and position control. Layer full-screen frames, festive borders, CRT scanlines, or film grain over the entire output.
      </li>
      <li>
        <strong>Picture in Picture:</strong> Layer animated images that drift, spin, and tilt across the display in real time. Works with JPG, PNG, or GIF folders with full control over density, speed, and movement style.
      </li>
      <li>
        <strong>Live Content &amp; Remote Config:</strong> Automatically pick up added or removed files without restarting. Update settings on the fly or feed live text from remote URLs.
      </li>
      <li>
        <strong>High-Fidelity Export:</strong> Export compositions as sequences of high-resolution, frame-accurate PNG frames for video rendering and distribution.
      </li>
    </ul>
  </description>

  <launchable type="desktop-id">io.github.xusione.AVWOWE.desktop</launchable>

  <provides>
    <binary>AVWOWE</binary>
  </provides>
</component>