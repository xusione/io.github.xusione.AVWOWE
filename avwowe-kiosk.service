# Host-side systemd --user unit for kiosk deployments.
# NOT shipped inside the Flatpak; install manually on the kiosk machine:
#   cp avwowe-kiosk.service ~/.config/systemd/user/
#   systemctl --user enable --now avwowe-kiosk.service
#
# If your media lives outside ~/Videos, ~/Pictures, ~/Music, grant the path once:
#   flatpak override --user io.github.xusione.AVWOWE --filesystem=/path/to/media

[Unit]
Description=AVWOWE Flatpak Kiosk Service
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/flatpak run io.github.xusione.AVWOWE
Restart=always
RestartSec=2s

[Install]
WantedBy=graphical-session.target
